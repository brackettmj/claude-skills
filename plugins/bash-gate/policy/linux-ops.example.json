{
  "description": "Example: the default plus read-only systemd and Python syntax checks. Copy it somewhere the gated run can't write, then point BASH_GATE_POLICY at the copy.",
  "commands": {
    "ls": {"args": "any"},
    "pwd": {"args": "any"},
    "wc": {"args": "any"},
    "stat": {"args": "any"},
    "du": {"args": "any"},
    "readlink": {"args": "any"},
    "realpath": {"args": "any"},
    "uname": {"args": "any"},
    "date": {"args": "any"},
    "bash": {"mode": "syntax-check"},
    "python3": {"mode": "py-compile"},
    "git": {
      "subcommands": ["log", "status", "diff", "show", "rev-parse", "describe", "blame"],
      "flags_with_value": ["-C", "--git-dir", "--work-tree", "--namespace"],
      "flags_before_subcommand": ["-P", "--no-pager", "--bare", "--no-replace-objects", "--no-optional-locks", "--literal-pathspecs"]
    },
    "systemctl": {
      "subcommands": ["list-timers", "show", "is-active", "is-enabled", "status", "cat"],
      "flags_before_subcommand": ["--user", "--system", "--no-pager", "--no-legend", "--legend", "--full", "-l", "--all", "-a", "--plain", "--value", "--quiet", "-q", "--recursive", "-r", "--no-ask-password"]
    }
  }
}
